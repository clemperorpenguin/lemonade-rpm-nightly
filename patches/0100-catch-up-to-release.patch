+    if (!body.contains("cfg_scale") && request.contains("cfg")) {
+        body["cfg_scale"] = request["cfg"];
+    }
+    forward_streaming_request("/sfx", body.dump(), sink, /*sse=*/false, /*timeout_seconds=*/900);
 }
 
