+                timeout=30,
+            )
+            # 200 = unloaded, 404 = nothing loaded — both OK
+            if response.status_code in [200, 404]:
+                return response
+        except requests.RequestException as exc:
+            if attempt == attempts:
+                raise exc
+            time.sleep(1)
     return response
 
 
