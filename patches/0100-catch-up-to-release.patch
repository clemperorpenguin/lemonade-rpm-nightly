+{"name": "min_total_chars-trace","note": "route_trace:true records the matching leaf under condition 'min_total_chars', not the 'min_chars' it shares an implementation with.","request": {"model": "user.Conditions-TotalCharBounds","route_trace": true,"messages": [{"role": "assistant","content": "abcdefghijklmnopqrstuvwxy"},{"role": "user","content": "0123456789abcde"}]},"decision": {"version": "1","route_to": "cloud","matched_rule": "min_total_chars-rule","default_used": false,"outputs": {},"trace": [{"condition": "min_total_chars","result": true}]}}
+{"name": "max_total_chars-trace","note": "Both earlier rules miss (traced false under their own condition names), then max_total_chars-rule matches under condition 'max_total_chars'.","request": {"model": "user.Conditions-TotalCharBounds","route_trace": true,"messages": [{"role": "user","content": "012345"}]},"decision": {"version": "1","route_to": "cloud","matched_rule": "max_total_chars-rule","default_used": false,"outputs": {},"trace": [{"condition": "min_total_chars","result": false},{"condition": "min_chars","result": false},{"condition": "max_total_chars","result": true}]}}
